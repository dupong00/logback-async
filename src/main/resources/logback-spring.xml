<?xml version="1.0" encoding="UTF-8" ?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty name="RUN_ID" source="app.run-id"/>

    <appender name="EVENT_FILE" class="ch.qos.logback.core.FileAppender">
        <file>runs/${RUN_ID}/events.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="EVENT_LOG" level="INFO" additivity="false">
        <appender-ref ref="EVENT_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>